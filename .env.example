# Copy this file to .env and adjust as needed. main.py reads these via
# os.environ -- if you use `python-dotenv` or similar to auto-load .env,
# install it separately; main.py itself does not assume a .env loader.

# --- Security -----------------------------------------------------------
# REQUIRED in any real deployment. The default in auth.py is a dev-only
# placeholder and must never be used outside a local sandbox.
VERIPACK_JWT_SECRET=change-this-to-a-long-random-value

# --- Server ---------------------------------------------------------------
PORT=5000
FLASK_DEBUG=0

# Comma-free single origin, or * for local development only. Never use *
# in production -- see docs/SECURITY.md.
VERIPACK_ALLOWED_ORIGIN=*

# --- Storage paths (all default to sensible locations under the repo if
# unset; override for production deployments, e.g. to mount a persistent
# volume or point at S3-backed local mounts) --------------------------------
VERIPACK_DB_PATH=storage/veripack.db
VERIPACK_EVIDENCE_DIR=storage/evidence
VERIPACK_REPORT_DIR=storage/reports
